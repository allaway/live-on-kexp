# KEXP Display Configuration
# Copy this file to .env and adjust settings for your setup:
#   cp .env.example .env

# How often to check KEXP API for new tracks (seconds)
UPDATE_INTERVAL=10

# RGB LED Matrix dimensions
MATRIX_ROWS=32
MATRIX_COLS=64

# Number of matrices chained together
MATRIX_CHAIN_LENGTH=1

# Number of parallel chains
MATRIX_PARALLEL=1

# Display brightness (0-100)
BRIGHTNESS=50

# Hardware mapping type (use adafruit-hat for Adafruit RGB Matrix Bonnet)
GPIO_MAPPING=adafruit-hat

# GPIO slowdown to reduce flickering
# Pi Zero 2W: try 2 or 3
# Pi 4: try 4
# Pi 5: try 2-3
GPIO_SLOWDOWN=4
